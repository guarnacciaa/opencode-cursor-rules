{
  "name": "@aguarnac/opencode-v2-cursor-rules",
  "version": "2.0.0",
  "description": "OpenCode v2 plugin for full Cursor rules (.mdc) support with frontmatter, globs, and all rule modes",
  "main": "index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "src/**/*.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-v2",
    "cursor",
    "cursorrules",
    "rules",
    "ai-coding",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aguarnac/opencode-v2-cursor-rules.git"
  },
  "bugs": {
    "url": "https://github.com/aguarnac/opencode-v2-cursor-rules/issues"
  },
  "author": "aguarnac",
  "license": "MIT",
  "scripts": {
    "prepare": "lefthook install",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "check:biome": "biome check .",
    "check:biome:fix": "biome check . --write",
    "check": "tsc --noEmit && biome check . && npm test",
    "release": "release-please release-pr --repo-url=https://github.com/aguarnac/opencode-v2-cursor-rules.git"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.26",
    "picomatch": "^4.0.3",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@types/node": "^22",
    "@types/picomatch": "^4.0.2",
    "effect": "^4.0.0-rc.112",
    "lefthook": "^2.1.0",
    "release-please": "^17.2.0",
    "typescript": "^5"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.112"
  }
}
